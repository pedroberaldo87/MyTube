{
  "name": "mytube",
  "version": "0.9.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "author": "Pedro Beraldo",
  "license": "GPL-3.0-only",
  "description": "Chrome extension to organize YouTube channels and playlists with folders and tags",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroberaldo87/MyTube.git"
  },
  "homepage": "https://github.com/pedroberaldo87/MyTube#readme",
  "keywords": [
    "youtube",
    "chrome-extension",
    "organizer",
    "preact",
    "manifest-v3"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsx build.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.mjs",
    "package": "npm run build && cd dist && zip -r ../mytube.zip ."
  },
  "dependencies": {
    "idb": "^8.0.3",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/chrome": "^0.1.42",
    "esbuild": "^0.25.12",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.2"
  }
}
